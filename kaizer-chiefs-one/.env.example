# Kaizer Chiefs One App — environment template. NAMES ONLY: never commit values.
# Copy to apps/mobile/.env.local (mobile) or apps/admin/.env.local (admin).
#
# EXPO_PUBLIC_* values are compiled INTO the mobile app and are public. Never
# put a secret in one. Provider credentials live only in Supabase function
# secrets (see "Server only" below).

# ---- Mobile app -------------------------------------------------------------
# local | staging | production. Production refuses to start with demo adapters.
EXPO_PUBLIC_APP_ENV=local

# Backend (public URL and the public anon key only).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Official store base URL, once confirmed.
EXPO_PUBLIC_SHOP_URL=
# EAS project id, for push notifications once approved.
EXPO_PUBLIC_EAS_PROJECT_ID=

# Capability flags: off | demo | live. Defaults: local = demo, staging/production = off.
# payments must stay off until a payment provider is approved.
EXPO_PUBLIC_FEATURE_CONTENT=
EXPO_PUBLIC_FEATURE_MATCH_DATA=
EXPO_PUBLIC_FEATURE_MEMBERSHIP=
EXPO_PUBLIC_FEATURE_TICKETS=
EXPO_PUBLIC_FEATURE_FAN_MOMENTS=
EXPO_PUBLIC_FEATURE_COMMERCE=
EXPO_PUBLIC_FEATURE_REWARDS=
EXPO_PUBLIC_FEATURE_NOTIFICATIONS=
EXPO_PUBLIC_FEATURE_PAYMENTS=off

# ---- Admin portal (server only) ---------------------------------------------
# local | staging | production. Production refuses demo sign-in.
ADMIN_APP_ENV=local
# 32+ random bytes, used to sign the admin session cookie.
ADMIN_SESSION_SECRET=
SUPABASE_URL=
# Server-side only. Never expose to a browser or the mobile app.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Supabase function secrets (set with `supabase secrets set`) -------------
# One block per provider, added when the club approves it, e.g.:
# MATCH_FEED_BASE_URL=
# MATCH_FEED_API_KEY=
# TICKETING_BASE_URL=
# TICKETING_CLIENT_ID=
# TICKETING_CLIENT_SECRET=
# REWARDS_BASE_URL=
# REWARDS_API_KEY=
# MEMBERSHIP_BASE_URL=
# MEMBERSHIP_API_KEY=
