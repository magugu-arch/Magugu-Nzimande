# Grateful website — server environment. Copy to .env for local development.
# Nothing here reaches the browser: only VITE_* variables are bundled, and there are none.

# Public URL of the site. Used in emails and as PayFast's return/cancel/notify base.
SITE_URL=http://localhost:5173

# Google Search Console ownership tag: the "content" value from Search Console's
# HTML-tag method (Settings → Ownership verification). Build-time only.
GOOGLE_SITE_VERIFICATION=

# --- Database (Supabase) -------------------------------------------------
# Unset → in-memory store (development only; production refuses to start without these).
SUPABASE_URL=
# Service-role key: server only. Never prefix with VITE_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Payments ------------------------------------------------------------
# payfast | mock. The mock gateway is refused in production.
PAYMENT_PROVIDER=mock
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
# true = sandbox.payfast.co.za. Set to false for live payments.
PAYFAST_SANDBOX=true
# Check ITNs come from PayFast's hosts. Disable only if your host hides the caller IP.
PAYFAST_VERIFY_SOURCE_IP=true

# --- Email ---------------------------------------------------------------
# resend | console (console prints emails to the server log).
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM="Grateful <bookings@your-verified-domain.co.za>"
STUDIO_EMAIL=gratefulpty@gmail.com

# --- Booking rules -------------------------------------------------------
BOOKING_HOLD_MINUTES=20
SLOT_STEP_MINUTES=30
MIN_NOTICE_HOURS=24
BOOKING_WINDOW_DAYS=60

# --- Newsletter ---------------------------------------------------------
# Signs unsubscribe links. Any long random string; required in production.
NEWSLETTER_SECRET=

# --- Admin ---------------------------------------------------------------
# Bearer token for POST /api/admin/bookings/:id/cancel. Unset → admin API disabled.
ADMIN_TOKEN=

# Development only: give in-memory services sample prices to try the checkout.
DEMO_PRICING=false

# Scheduler secret for the daily reminder job (/api/cron/reminders). On Vercel,
# setting CRON_SECRET is enough: its cron sends it automatically.
CRON_SECRET=
