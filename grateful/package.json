{
  "name": "grateful-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "verify": "npm run typecheck && npm run lint && npm test && vite build",
    "smoke": "node e2e/smoke.mjs",
    "build:demo": "vite build --mode demo --base ./ --outDir dist-demo",
    "build:single": "vite build --mode single",
    "build:handover": "node scripts/build-handover.mjs",
    "build:whatsapp": "node scripts/build-whatsapp.mjs",
    "build:previews": "npm run build:single && cp dist-single/index.html preview/Grateful-Website-Preview.html && npm run build:handover && npm run build:whatsapp",
    "check:launch": "node scripts/check-launch.mjs",
    "apply:intake": "node scripts/apply-intake.mjs",
    "build:setup-sql": "node scripts/build-setup-sql.mjs",
    "gen:secrets": "node scripts/gen-secrets.mjs"
  },
  "dependencies": {
    "@fontsource-variable/baskervville": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@supabase/supabase-js": "^2.117.2",
    "framer-motion": "^13.4.4",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.2"
  }
}
