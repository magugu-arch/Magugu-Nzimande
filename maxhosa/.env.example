# MAXHOSA AFRICA app — environment template. Placeholders only.
# Copy to .env.local. Only EXPO_PUBLIC_* values reach the app bundle, so
# nothing secret ever belongs in this file: private commerce, courier and
# booking credentials live on the integration service, never in the app.

# Which adapter each domain uses. "mock" is the only implementation today;
# the others are named in docs/INTEGRATION_STATUS.md and land after discovery.
EXPO_PUBLIC_COMMERCE_PROVIDER=mock
EXPO_PUBLIC_DELIVERY_PROVIDER=mock
EXPO_PUBLIC_BOOKING_PROVIDER=mock
EXPO_PUBLIC_EVENTS_PROVIDER=mock

# Public storefront domain (Storefront API / checkout handoff), once verified.
EXPO_PUBLIC_STOREFRONT_DOMAIN=
# A Storefront API token is public by design; an Admin API token is not and
# must never be placed here.
EXPO_PUBLIC_STOREFRONT_PUBLIC_TOKEN=

# The lean integration service (booking, courier webhooks, notifications).
EXPO_PUBLIC_INTEGRATION_API_URL=
