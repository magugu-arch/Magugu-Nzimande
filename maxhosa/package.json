{
  "name": "maxhosa-africa-app",
  "version": "0.1.0",
  "description": "MAXHOSA AFRICA app \u2014 concept build. Expo SDK 57, mock commerce/delivery/booking adapters, offline single-file demo.",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"__tests__/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"__tests__/**/*.{ts,tsx}\"",
    "test": "jest",
    "verify": "npm run assets:verify && npm run typecheck && npm run lint && npm run format:check && npm test",
    "assets:manifest": "node scripts/assets.mjs --write",
    "assets:verify": "node scripts/assets.mjs",
    "demo:build": "npm run assets:verify && node scripts/build-offline-demo.mjs",
    "demo:test": "node scripts/test-offline-demo.mjs",
    "export:web": "expo export --platform web --output-dir .web-preview",
    "shots:web": "node scripts/web-screens.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/playfair-display": "^0.4.2",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.27",
    "expo-asset": "~57.0.19",
    "expo-blur": "~57.0.3",
    "expo-constants": "~57.0.21",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-linking": "~57.0.12",
    "expo-router": "~57.0.25",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "zod": "^4.6.6",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "~57.0.14",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "playwright": "^1.62.1",
    "prettier": "^3.9.10",
    "react-test-renderer": "^19.2.3",
    "typescript": "~6.0.3"
  }
}
