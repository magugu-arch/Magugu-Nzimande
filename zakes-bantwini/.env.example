# ─────────────────────────────────────────────────────────────────────────────
# Zakes Bantwini website — environment variables
# Copy to .env.local for development. In production set these in the host's
# dashboard (Vercel → Project → Settings → Environment Variables). Never commit
# real values. Everything here is read on the server only unless it starts
# with NEXT_PUBLIC_.
# ─────────────────────────────────────────────────────────────────────────────

# Canonical origin, used for links in emails, Open Graph, sitemap and payment callbacks.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 32+ random characters. Signs admin sessions and client booking links.
# Generate: node -e "console.log(require('crypto').randomBytes(36).toString('base64url'))"
# Rotating it signs everyone out and invalidates existing client booking links.
APP_SECRET=

# Allow search engines to index the site. Leave unset on previews.
ALLOW_INDEXING=false

# ── Content ────────────────────────────────────────────────────────────────
# Launch mode: only management-approved content renders (set at build time).
CONTENT_PUBLISH_APPROVED_ONLY=false
# Show "pending approval" markers on unapproved content (ignored in launch mode).
CONTENT_SHOW_FLAGS=true

# ── Database ───────────────────────────────────────────────────────────────
# Postgres (Supabase, Neon, RDS…). Include ?sslmode=require for hosted databases.
# Apply the schema with: npm run db:migrate
DATABASE_URL=
DATABASE_POOL_MAX=5
# Without DATABASE_URL, development uses a JSON file. Production refuses to,
# unless this is set — only for a single long-running preview server.
ALLOW_FILE_STORE=false
FILE_STORE_PATH=

# ── Private documents (event briefs, agreements, riders) ───────────────────
# Supabase Storage, private bucket. Without these, files go to .data/uploads.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=booking-documents
UPLOAD_DIR=

# ── Admin ──────────────────────────────────────────────────────────────────
# First-run only: lets one owner sign in while no admin accounts exist, which
# creates the account. Remove both once set up (or use npm run admin:create).
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_NAME=Management

# ── Payments ───────────────────────────────────────────────────────────────
# payfast | peach | sandbox. Development defaults to sandbox; production has no default.
PAYMENTS_PROVIDER=
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_SANDBOX=true
# Only for local testing behind a tunnel; never in production.
PAYFAST_SKIP_IP_CHECK=false
# Lets the no-money sandbox gateway run on a production build (staging demos, CI).
ALLOW_SANDBOX_PAYMENTS=false

# ── Notifications ──────────────────────────────────────────────────────────
# Email (Resend). Without these, messages are logged and recorded, not sent.
RESEND_API_KEY=
EMAIL_FROM="Zakes Bantwini Bookings <bookings@your-domain>"
EMAIL_REPLY_TO=
# Management copies of booking events, and collaboration proposals.
BOOKINGS_INBOX_EMAIL=
PARTNERSHIPS_INBOX_EMAIL=
# SMS (Twilio) — optional.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# WhatsApp (Meta Cloud API) — optional; needs approved templates named zb_<event>.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_PREFIX=zb_
WHATSAPP_TEMPLATE_LANGUAGE=en

# ── Community ──────────────────────────────────────────────────────────────
# Optional: forward signups to an email platform or automation (JSON POST).
COMMUNITY_WEBHOOK_URL=
COMMUNITY_WEBHOOK_SECRET=

# ── Scheduled jobs ─────────────────────────────────────────────────────────
# Bearer secret for /api/cron/reminders (Vercel Cron sends it automatically).
CRON_SECRET=
BOOKING_HOLD_DAYS=7

# ── Analytics ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
POSTHOG_API_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
