# Server-side configuration for a production deployment of the Tashas API.
# Nothing here is needed for the sandbox build, and none of it may ever be
# embedded in the web app or a mobile bundle. Values are placeholders.

# Public address of the web app once it is on a stable HTTPS domain.
PUBLIC_APP_URL=

# PostgreSQL (schema in docs/ARCHITECTURE.md).
DATABASE_URL=

# Reservation provider, once Tashas names and contracts one.
RESERVATION_PROVIDER=
RESERVATION_API_BASE_URL=
RESERVATION_API_KEY=
RESERVATION_WEBHOOK_SECRET=

# Payment gateway, once the merchant account is confirmed.
PAYMENT_PROVIDER=
PAYMENT_API_BASE_URL=
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=
PAYMENT_CURRENCIES=ZAR

# Messaging.
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=
PUSH_PROVIDER=
PUSH_CREDENTIALS=
# Leave empty until a provider, sender and templates are approved.
SMS_PROVIDER=
WHATSAPP_PROVIDER=

# Measurement and maps.
ANALYTICS_MEASUREMENT_ID=
MAPS_API_KEY=

# Error monitoring.
ERROR_REPORTING_DSN=
