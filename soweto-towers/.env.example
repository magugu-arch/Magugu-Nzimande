# Soweto Towers website: environment variables
# Copy to .env.local for local work. Every value is optional for a preview:
# with nothing set, the site runs on a built-in demo database, simulated
# payments and simulated messages (logged in the staff console Outbox).

# ── Site ─────────────────────────────────────────────────────────────────────
# Public address, used for canonical URLs, share images, sitemaps, emails.
NEXT_PUBLIC_SITE_URL=https://sowetotowers.co.za
# Set to "production" ONLY on the live domain. Anything else keeps search
# engines out (robots noindex), so previews never compete with the real site.
NEXT_PUBLIC_SITE_ENV=
# Google Search Console HTML-tag verification code (content="..." value only).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# "Leave a review" link sent the day after a visit (Google Business Profile).
NEXT_PUBLIC_GOOGLE_REVIEW_URL=

# ── Contact and social ───────────────────────────────────────────────────────
# WhatsApp number in international format, digits only (default 27716744343).
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_TIKTOK_URL=
NEXT_PUBLIC_LINKEDIN_URL=

# Approximate exchange rates for the "about $35" hint shown to visitors.
NEXT_PUBLIC_FX_USD=0.055
NEXT_PUBLIC_FX_EUR=0.051
NEXT_PUBLIC_FX_GBP=0.043

# ── Database ─────────────────────────────────────────────────────────────────
# Hosted Postgres (Neon, Supabase, RDS…). Unset = built-in demo database.
DATABASE_URL=
# Run migrations automatically on start (otherwise: npm run db:migrate).
DB_AUTO_MIGRATE=0
DB_POOL_MAX=5
# Demo database only: store location, or 1 to keep it in memory.
PGLITE_DIR=
PGLITE_MEMORY=
# Set to 0 to skip loading the sample launch-calendar events.
SEED_SAMPLE_EVENTS=1

# ── Staff console ────────────────────────────────────────────────────────────
# Long random string (32+ characters). Required in production.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=
# First admin account, created on first start if it doesn't exist.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# ── Payments: PayFast ────────────────────────────────────────────────────────
# With no merchant details, checkout runs in simulated test mode.
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
# The passphrase set under Settings → Developer settings in PayFast.
PAYFAST_PASSPHRASE=
# 1 = sandbox.payfast.co.za (default). Set to 0 for live payments.
PAYFAST_SANDBOX=1
# Check that payment notifications come from PayFast's servers (keep on).
PAYFAST_CHECK_IP=1

# ── Email: Resend ────────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM="Soweto Towers <bookings@sowetotowers.co.za>"
# Where new chats, enquiries and table requests are sent.
STAFF_NOTIFY_EMAIL=

# ── WhatsApp: Meta Cloud API ─────────────────────────────────────────────────
# Template messages must be approved in WhatsApp Manager first (see README).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v23.0
WHATSAPP_TEMPLATE_LANG=en

# ── Web push (ticket reminders, weather holds) ───────────────────────────────
# Generate once: npx web-push generate-vapid-keys
# Unset = a key pair is generated and stored in the database.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ── Scheduled jobs ───────────────────────────────────────────────────────────
# Bearer token for /api/cron/daily (reminders, follow-ups, gift delivery).
CRON_SECRET=

# ── Analytics (only load after visitor consent) ──────────────────────────────
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
