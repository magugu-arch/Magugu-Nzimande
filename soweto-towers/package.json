{
  "name": "soweto-towers",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "node tests/e2e/booking.mjs ${BASE_URL:-http://localhost:3000} && node tests/e2e/flows.mjs ${BASE_URL:-http://localhost:3000} && node tests/e2e/admin.mjs ${BASE_URL:-http://localhost:3000} && node tests/e2e/slow-network.mjs ${BASE_URL:-http://localhost:3000}",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db-migrate.mts",
    "assets:import": "node scripts/import-images.mjs",
    "assets:manifest": "node scripts/build-image-manifest.mjs",
    "assets:icons": "tsx scripts/build-icons.mts",
    "assets:og": "tsx scripts/og-images.mts",
    "share:page": "tsx scripts/build-share-page.mts",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.6.1",
    "drizzle-orm": "^0.45.4",
    "jose": "^6.2.18",
    "jsqr": "^1.4.0",
    "motion": "^14.14.0",
    "next": "16.4.6",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "web-push": "^4.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource-variable/exo-2": "^5.3.0",
    "@types/node": "^22.20.7",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "^10.1.9",
    "playwright": "^1.63.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.2"
  },
  "engines": {
    "node": ">=20.9"
  }
}
