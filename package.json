{
  "name": "bbq-chicken-sa",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"__tests__/**/*.{ts,tsx}\"",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "assets:derive": "node scripts/generate-image-derivatives.mjs && node scripts/generate-asset-registry.mjs",
    "assets:audit": "node scripts/audit-food-assets.mjs",
    "assets:audit:warn": "node scripts/audit-food-assets.mjs --warn",
    "assets:registry": "node scripts/generate-asset-registry.mjs",
    "assets:brand": "node scripts/generate-brand-assets.mjs",
    "assets:typefit": "node scripts/audit-type-fit.mjs",
    "preview:web": "expo start --web",
    "audit:screens": "node scripts/audit-screens.mjs",
    "smoke:order": "node scripts/smoke-order.mjs",
    "build:dev": "eas build --profile development --platform all",
    "build:dev:ios": "eas build --profile development --platform ios",
    "build:dev:android": "eas build --profile development --platform android",
    "build:sim": "eas build --profile development-simulator --platform ios",
    "build:preview": "eas build --profile preview --platform all",
    "build:prod": "npm run audit:launch -- --production && eas build --profile production --platform all",
    "submit:prod": "eas submit --profile production --platform all",
    "prebuild": "expo prebuild --clean",
    "doctor": "npx expo-doctor",
    "audit:native": "node scripts/audit-native.mjs",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"__tests__/**/*.{ts,tsx}\"",
    "audit:launch": "node scripts/audit-launch-readiness.mjs",
    "audit:offline": "node scripts/audit-offline.mjs",
    "audit:coldstart": "node scripts/audit-coldstart.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/montserrat": "^0.4.2",
    "@expo-google-fonts/playfair-display": "^0.4.2",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "^12.0.1",
    "@tanstack/react-query": "^5.101.4",
    "expo": "~57.0.15",
    "expo-asset": "~57.0.13",
    "expo-build-properties": "~57.0.13",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.13",
    "expo-dev-client": "~57.0.14",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.3",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.7",
    "expo-location": "~57.0.12",
    "expo-notifications": "~57.0.13",
    "expo-router": "~57.0.15",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.7",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "expo-updates": "~57.0.16",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "babel-plugin-module-resolver": "^5.0.3",
    "babel-preset-expo": "~57.0.7",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.1",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.4",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "react-dom": "19.2.3",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-test-renderer": "19.2.3"
  }
}
