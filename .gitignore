# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# Next.js (apps/web)
.next/
next-env.d.ts
.vercel/

# Web derivatives — generated from the masters by infra/scripts, never
# committed, so a committed copy cannot go stale against the master it came
# from. Run `npm run assets:derive` in apps/web; dev and build already do.
apps/web/public/food/
apps/web/public/brand/

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local

# test output
coverage/

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# throwaway web builds and their captures — regenerate with the scripts that
# made them rather than committing several megabytes of screenshot
.audit-*/
.preview-web/
.preview-shots/

# The single-file review build — generated from the template and the masters by
# infra/scripts/build-static-demo.mjs, 2.7 MB of embedded images.
apps/web/static-demo/bbq-chicken-website.html
