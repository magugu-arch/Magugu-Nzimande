# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# Next.js (apps/web)
.next/
next-env.d.ts
.vercel/

# Web image derivatives — generated from the masters by infra/scripts, never
# committed. Run `npm run assets:derive` in apps/web, or just `npm run build`.
apps/web/public/food/

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local

# test output
coverage/

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# throwaway web builds and their captures — regenerate with the scripts that
# made them rather than committing several megabytes of screenshot
.audit-*/
.preview-web/
.preview-shots/
