{
  "expo": {
    "name": "Pappas",
    "slug": "pappas-app",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/00000000-0000-0000-0000-000000000000",
      "fallbackToCacheTimeout": 0,
      "checkAutomatically": "ON_LOAD"
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "pappas",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "backgroundColor": "#221E1F",
    "primaryColor": "#E31937",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#E31937"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "za.co.pappasrestaurant.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Pappas uses your location to estimate delivery times and give you directions to the restaurant.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "za.co.pappasrestaurant.app",
      "adaptiveIcon": {
        "backgroundColor": "#E31937",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": ["ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION"],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#E31937",
          "imageWidth": 260
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Pappas uses your location to estimate delivery times and give you directions to the restaurant.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "motionUsagePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#E31937",
          "defaultChannel": "orders"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4"
          },
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "minSdkVersion": 24
          }
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiBaseUrl": "https://api.pappasrestaurant.co.za",
      "eas": {
        "projectId": "00000000-0000-0000-0000-000000000000"
      }
    }
  }
}
