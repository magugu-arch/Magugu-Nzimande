{
  "expo": {
    "name": "bb.q Chicken",
    "slug": "bbq-chicken-sa",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "bbqchicken",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "backgroundColor": "#221E1E",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#E31937"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "za.co.bbqchicken.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "bb.q Chicken uses your location to find your nearest store and estimate delivery times.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "za.co.bbqchicken.app",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "backgroundColor": "#E31937",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": ["ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION"]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#E31937",
          "imageWidth": 180
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "bb.q Chicken uses your location to find your nearest store and estimate delivery times."
        }
      ],
      "expo-secure-store",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiBaseUrl": "https://api.bbqchicken.co.za",
      "eas": {
        "projectId": "00000000-0000-0000-0000-000000000000"
      }
    }
  }
}
