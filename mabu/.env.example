# Mábu — public (client) configuration. Secrets never go here: anything prefixed
# EXPO_PUBLIC_ is compiled into the app bundle and readable by anyone.
EXPO_PUBLIC_API_BASE_URL=https://api.maburestaurant.com
# 1 = run entirely against the in-app mock backend (default). 0 = call the API.
EXPO_PUBLIC_USE_MOCK_API=1

# Feature flags (brief §22 and §45). Client copies only decide what is *shown*;
# the server holds the authoritative values and enforces them.
EXPO_PUBLIC_MABU_BOOKING_ENABLED=true
EXPO_PUBLIC_MABU_BOOKING_PROVIDER=mabu-direct
EXPO_PUBLIC_MABU_WAITLIST_ENABLED=true
EXPO_PUBLIC_MABU_BOOKING_DEPOSIT_ENABLED=false
EXPO_PUBLIC_MABU_REWARDS_ENABLED=true
EXPO_PUBLIC_MABU_REWARDS_EARNING_ENABLED=true
EXPO_PUBLIC_MABU_REWARDS_REDEMPTION_ENABLED=true
EXPO_PUBLIC_MABU_NOTIFICATIONS_ENABLED=true
EXPO_PUBLIC_MABU_PUSH_ENABLED=true
EXPO_PUBLIC_MABU_EMAIL_ENABLED=true
EXPO_PUBLIC_MABU_SMS_ENABLED=false
EXPO_PUBLIC_MABU_WHATSAPP_ENABLED=false
EXPO_PUBLIC_MABU_MARKETING_NOTIFICATIONS_ENABLED=false
EXPO_PUBLIC_MABU_VOUCHERS_ENABLED=true
EXPO_PUBLIC_MABU_EVENTS_ENABLED=true
EXPO_PUBLIC_MABU_DIRECT_ORDERING_ENABLED=false
EXPO_PUBLIC_UBER_EATS_ENABLED=false
EXPO_PUBLIC_MR_D_ENABLED=false

# Website (web build only). The public address of the site, used for canonical
# links, the sitemap and social cards.
EXPO_PUBLIC_SITE_URL=https://maburestaurant.com
# Google Search Console's HTML-tag verification token, if that method is used.
EXPO_PUBLIC_GOOGLE_SITE_VERIFICATION=
