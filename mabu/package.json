{
  "name": "mabu-restaurant",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"__tests__/**/*.{ts,tsx}\" \"server/src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"__tests__/**/*.{ts,tsx}\" \"server/src/**/*.ts\"",
    "test": "jest --passWithNoTests",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run db:check && npm run server:check",
    "assets:photos": "node scripts/derive-photos.mjs",
    "export:web": "npm run content:snapshot && expo export --platform web --output-dir dist-web && npm run seo",
    "shots": "node scripts/screens.mjs",
    "e2e": "node scripts/journeys.mjs",
    "verify:web": "npm run export:web && npm run shots && npm run e2e",
    "db:check": "node scripts/check-migrations.mjs",
    "server:build": "esbuild server/src/main.ts --bundle --platform=node --format=esm --target=node20 --packages=external --tsconfig=tsconfig.json --outfile=server/dist/main.mjs",
    "server:start": "node server/dist/main.mjs",
    "server:dev": "npm run server:build && MABU_DEV_LOG_EMAIL=1 MABU_DIRECT_INVENTORY=1 node server/dist/main.mjs",
    "server:check": "node scripts/check-server.mjs",
    "standalone": "npm run export:web && node scripts/standalone.mjs",
    "standalone:check": "node scripts/check-standalone.mjs",
    "content:snapshot": "node scripts/content-snapshot.mjs",
    "seo": "node scripts/seo.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/allura": "^0.4.2",
    "@expo-google-fonts/montserrat": "^0.4.2",
    "@expo-google-fonts/playfair-display": "^0.4.2",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tanstack/react-query": "^5.104.0",
    "expo": "~57.0.15",
    "expo-asset": "~57.0.13",
    "expo-calendar": "~57.0.5",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.13",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.3",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.7",
    "expo-notifications": "~57.0.13",
    "expo-router": "~57.0.15",
    "expo-splash-screen": "~57.0.7",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "nodemailer": "^10.0.12",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.3",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.15"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-test-renderer": "19.2.3"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@electric-sql/pglite": "^0.5.8",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "~19.2.2",
    "babel-plugin-module-resolver": "^5.0.3",
    "babel-preset-expo": "~57.0.7",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.1",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "opentype.js": "^2.0.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "react-test-renderer": "19.2.3",
    "sharp": "^0.35.5",
    "typescript": "~6.0.3"
  }
}
