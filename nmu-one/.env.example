# NMU ONE — environment template. See docs/ENVIRONMENT.md for every variable.
# Copy to .env.local. Only EXPO_PUBLIC_* values are inlined into the client
# bundle, so nothing secret belongs here: credentials live in the BFF.

# "mock" runs every integration against the bundled synthetic adapters.
# "live" wires the production adapters, which refuse to run until each one's
# base URL below is configured — see docs/INTEGRATIONS.md.
EXPO_PUBLIC_DATA_MODE=mock

# Backend-for-frontend base URL. NMU ONE never talks to specialist systems
# directly; the BFF holds the credentials and fans out to them.
EXPO_PUBLIC_BFF_BASE_URL=

# OIDC identity provider (NMU SSO). Authorization-code + PKCE only.
EXPO_PUBLIC_OIDC_ISSUER=
EXPO_PUBLIC_OIDC_CLIENT_ID=

# Demo clock for presentations. "scenario" pins the start of the session to
# 09:40 SAST on the next weekday so the pitch journey reads the same at any hour;
# "live" uses the device clock.
EXPO_PUBLIC_DEMO_CLOCK=scenario

# Mock adapter latency in milliseconds, and adapters that should fail, for
# demonstrating error states (comma-separated: academic,finance,library,...).
EXPO_PUBLIC_MOCK_LATENCY_MS=350
EXPO_PUBLIC_MOCK_FAILURES=

# Seconds between paying for a campus order and the mock kitchen marking it
# ready for pickup.
EXPO_PUBLIC_MOCK_ORDER_READY_SECONDS=20
