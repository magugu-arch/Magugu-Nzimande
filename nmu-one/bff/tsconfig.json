{
  "compilerOptions": {
    "target": "ES2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "rootDir": "..",
    "outDir": "dist",
    // The console's shared modules import the core as @core (admin/tsconfig.json).
    // tsc keeps the specifier; bff/link-core.mjs makes it resolve at runtime.
    "paths": { "@core/*": ["../src/core/*"] }
  },
  "include": ["src/**/*.ts"]
}
