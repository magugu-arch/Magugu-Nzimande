# bb.q Chicken SA — environment template.
# Copy to .env.local and fill in real values. NEVER commit real keys.
# Only EXPO_PUBLIC_* vars are inlined into the client bundle; anything secret
# belongs on the backend, not here.

# Backend API
EXPO_PUBLIC_API_BASE_URL=https://api.bbqchicken.co.za
EXPO_PUBLIC_API_TIMEOUT_MS=15000

# Set to "1" to run the app entirely against the bundled mock service layer.
EXPO_PUBLIC_USE_MOCK_API=1

# Maps (store locator). Provider is abstracted — swap without touching screens.
EXPO_PUBLIC_MAPS_PROVIDER=google
EXPO_PUBLIC_MAPS_API_KEY=

# South African payment gateway (publishable/checkout key only).
EXPO_PUBLIC_PAYMENT_PROVIDER=peach
EXPO_PUBLIC_PAYMENT_PUBLIC_KEY=

# Push notifications
EXPO_PUBLIC_PUSH_PROJECT_ID=
