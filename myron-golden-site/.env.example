# Copy to .env.local for local development. Never commit real values.

# ── Site ────────────────────────────────────────────────────────────────
# preview (default): preview ribbon, demo fixtures and drafts visible, forms
#   log instead of sending, every page noindex, robots.txt disallows all.
# production: demo and draft records are removed at the data layer, forms
#   refuse to report success unless a webhook delivers, pages are indexable.
NEXT_PUBLIC_SITE_MODE=preview

# The final public origin, used for canonical URLs, the sitemap and social
# cards. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# The real course/community platform. Without it, /login sends members to
# the official site instead.
NEXT_PUBLIC_MEMBER_PORTAL_URL=

# GA4 measurement ID (G-XXXXXXXXXX). Leave empty for no analytics and no
# cookie banner. When set, analytics loads only after the visitor opts in.
NEXT_PUBLIC_GA_ID=

# ── Form delivery (server-only) ─────────────────────────────────────────
# Each form POSTs JSON to a webhook the team controls: a CRM, the email
# provider, or an automation tool (Zapier, Make, n8n…).
ENQUIRY_WEBHOOK_URL=
# Falls back to ENQUIRY_WEBHOOK_URL when empty.
CONTACT_WEBHOOK_URL=
NEWSLETTER_WEBHOOK_URL=

# If set, every webhook request carries x-signature-sha256: an HMAC-SHA256
# of the raw body with this secret, so the receiver can verify the sender.
WEBHOOK_SIGNING_SECRET=
