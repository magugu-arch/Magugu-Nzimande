# Copy to .env.local for local development. Never commit real values.

# ── Site ────────────────────────────────────────────────────────────────
# preview (default): preview ribbon, demo fixtures and drafts visible, forms
#   log instead of sending, every page noindex, robots.txt disallows all.
# production: demo and draft records are removed at the data layer, forms
#   refuse to report success unless a webhook delivers, pages are indexable.
NEXT_PUBLIC_SITE_MODE=preview

# The final public origin, used for canonical URLs, the sitemap and social
# cards. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# The real course/community platform. Without it, /login sends members to
# the official site instead.
NEXT_PUBLIC_MEMBER_PORTAL_URL=

# GA4 measurement ID (G-XXXXXXXXXX). Leave empty for no analytics and no
# cookie banner. When set, analytics loads only after the visitor opts in.
NEXT_PUBLIC_GA_ID=

# ── Form delivery (server-only) ─────────────────────────────────────────
# Each form POSTs JSON to a webhook the team controls: a CRM, the email
# provider, or an automation tool (Zapier, Make, n8n…).
ENQUIRY_WEBHOOK_URL=
# Falls back to ENQUIRY_WEBHOOK_URL when empty.
CONTACT_WEBHOOK_URL=
NEWSLETTER_WEBHOOK_URL=

# If set, every webhook request carries x-signature-sha256: an HMAC-SHA256
# of the raw body with this secret, so the receiver can verify the sender.
WEBHOOK_SIGNING_SECRET=
# Event bookings: every request, free registration and paid booking.
# Falls back to ENQUIRY_WEBHOOK_URL when empty. Production refuses to open
# checkout until one of the two is set, so no paid booking goes unrecorded.
BOOKING_WEBHOOK_URL=
# Book orders: when checkout starts and when Stripe confirms payment (with the
# delivery address). Falls back to BOOKING_WEBHOOK_URL, then ENQUIRY_WEBHOOK_URL.
ORDER_WEBHOOK_URL=

# ── Payments: Stripe Checkout (server-only) ─────────────────────────────
# Checkout stays off until a key is set. Use a TEST key (sk_test_…) in
# preview; a test key is refused in production. A LIVE key (sk_live_… or a
# restricted rk_live_…) works only with NEXT_PUBLIC_SITE_MODE=production AND
# PAYMENTS_LIVE_APPROVED=true — set that only with the owner's written
# approval to take real payments.
STRIPE_SECRET_KEY=
PAYMENTS_LIVE_APPROVED=
# Signing secret of the webhook endpoint (whsec_…) for
# https://<site>/api/stripe/webhook, listening to checkout.session.completed,
# checkout.session.async_payment_succeeded and ..._async_payment_failed.
STRIPE_WEBHOOK_SECRET=
# Optional: pin the Stripe API version (for example the one the account
# was created on). Empty uses the account's default.
STRIPE_API_VERSION=

# Book shipping. Create a shipping rate in the Stripe dashboard (it holds the
# price) and paste its id (shr_…). Production refuses book checkout without
# it. SHOP_SHIP_TO lists the countries to ship to, comma-separated (default US).
STRIPE_SHIPPING_RATE_ID=
SHOP_SHIP_TO=US
