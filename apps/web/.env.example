# bb.q Chicken South Africa — ordering website
#
# Copy to .env.local and fill in. Every variable here is optional, and the
# feature it controls fails closed without it: an unset secret switches its
# feature off rather than leaving it open. `GET /api/health` reports which are
# configured, so a deployment that has quietly lost one is visible before a
# customer finds it.
#
# Nothing in this file is a real secret. Do not put one here — .env.local is
# gitignored, this file is not.
#
# Nothing here is prefixed NEXT_PUBLIC_, so nothing here reaches the browser
# bundle. Keep it that way: a secret with that prefix is a published secret,
# and no build step will warn you.

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------

# Where orders, accounts and console writes are kept. Defaults to the system
# temp directory, which is wiped on restart — set it to a persistent path on
# any deployment that is meant to keep an order overnight.
#
# This is the stopgap for Postgres. It holds a cross-process lock for each
# write, so concurrent edits are safe, but it has no rollback and no query.
BBQ_STATE_FILE=/var/lib/bbq/state.json

# ---------------------------------------------------------------------------
# Operations console
# ---------------------------------------------------------------------------

# One shared passphrase for kitchen staff. Unset, the console refuses everyone
# — recoverable. There is deliberately no default.
#
# The session signing key is derived from this, so changing it ends every live
# session by construction.
#
# Use a long random value, not a word:
#   node -e "console.log(require('node:crypto').randomBytes(24).toString('base64url'))"
BBQ_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Customer accounts
# ---------------------------------------------------------------------------

# Signs customer session cookies. At least 16 characters; unset or shorter and
# registration and sign-in both refuse, because minting sessions that cannot be
# verified is worse than not minting any.
#
# Rotating it signs every customer out. That is the intended behaviour after a
# suspected leak.
#
#   node -e "console.log(require('node:crypto').randomBytes(24).toString('base64url'))"
BBQ_SESSION_SECRET=

# ---------------------------------------------------------------------------
# Payments
# ---------------------------------------------------------------------------

# Both or neither. A named provider with no secret cannot verify a callback,
# which would leave the webhook open to anyone who found the path, so the
# registry treats that as switched off.
#
# Two adapters exist: `payfast` and `sandbox`.
#
# `sandbox` signs and settles the way a real gateway does and moves no money.
# It is for driving the path with no merchant account at all, and
# `BBQ_PAYMENT_PROVIDER=sandbox` in production is something a deployment
# checklist should grep for.
#
# For PayFast, BBQ_PAYMENT_SECRET is the passphrase set on the merchant
# account under Settings. It is what makes a signature mean anything: without
# it, anyone who finds the notification URL can settle orders.
BBQ_PAYMENT_PROVIDER=
BBQ_PAYMENT_SECRET=

# ---------------------------------------------------------------------------
# PayFast
# ---------------------------------------------------------------------------

# Only read when BBQ_PAYMENT_PROVIDER=payfast, and all of them are needed —
# a PayFast adapter missing its merchant id builds a redirect PayFast rejects,
# and one missing the public URL sends notifications nowhere, which means the
# payment succeeds and the order never hears about it.
#
# The merchant id and key are not secret in the way the passphrase is: they
# travel in the redirect the customer's browser can read.
BBQ_PAYFAST_MERCHANT_ID=
BBQ_PAYFAST_MERCHANT_KEY=

# Live only when this says exactly `false`. Unset, empty, `0`, `no`, or a typo
# all keep the sandbox, because the mistake in the other direction takes real
# money on a deployment somebody believed was a test.
BBQ_PAYFAST_SANDBOX=

# Where this deployment answers, with no trailing slash. PayFast builds the
# return, cancel and notify URLs from it, and it must be reachable from the
# public internet or no notification ever arrives.
#
# PayFast also needs outbound access to payfast.co.za: a notification is posted
# back to them for confirmation, and that check fails closed.
BBQ_PUBLIC_URL=

# ---------------------------------------------------------------------------
# Courier — Uber Direct
# ---------------------------------------------------------------------------

# Uber Eats is a marketplace, where customers order in Uber's app. Uber Direct
# is the courier underneath it, where the customer orders here and an Uber
# driver delivers. This is Direct.
#
# Set BBQ_COURIER_PROVIDER=uber-direct to switch it on. Unset, orders still
# stand and still reach the console — a store can drive them out itself — which
# is the opposite of the payment seam, and deliberate.
BBQ_COURIER_PROVIDER=

# OAuth client credentials and the merchant organisation id from the Uber
# Direct dashboard. All three or none: two of them get a token Uber refuses,
# and one of them builds a URL that 404s, both of which read as an outage
# rather than a missing variable.
BBQ_UBER_CLIENT_ID=
BBQ_UBER_CLIENT_SECRET=
BBQ_UBER_CUSTOMER_ID=

# Issued separately, per webhook, when the callback is registered. Uber signs
# every delivery update with it, and without it the callback endpoint cannot
# verify anything and refuses everything — which is right, because that URL
# moves orders to out-for-delivery and completed.
BBQ_UBER_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Not an environment variable
# ---------------------------------------------------------------------------

# The unapproved-price flags in the interface are switched by DEMO_DATA in
# infra/seed/demo-values.ts, which is a compile-time constant and not read from
# here. An earlier version of this file listed it as `DEMO_DATA=true`, which was
# never true and would have had somebody setting it in a deployment and
# wondering why every price still carried a [CONFIRM] badge.
#
# When the franchisor's approved prices land, that constant goes to false and
# the flags leave the build entirely rather than being hidden at runtime.
