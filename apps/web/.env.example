# bb.q Chicken SA — ordering website environment template.
# Copy to .env.local and fill in real values. NEVER commit real secrets.
#
# Nothing here is prefixed NEXT_PUBLIC_, so nothing here reaches the browser
# bundle. Keep it that way: a secret with that prefix is a published secret.

# ---------------------------------------------------------------------------
# Operations console
# ---------------------------------------------------------------------------
# The shared operator passphrase. The console fails CLOSED: with this unset,
# nobody can sign in and every console write endpoint answers 503. That is
# deliberate — a locked console is recoverable, an open one is not.
#
# Rotating it ends every live session, because the session signing key is
# derived from it.
#
# Use a long random value, not a word. For example:
#   node -e "console.log(require('node:crypto').randomBytes(24).toString('base64url'))"
BBQ_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Demo state
# ---------------------------------------------------------------------------
# Where orders and console writes are kept, standing in for Postgres. Defaults
# to a file in the system temp directory. Several worker processes read and
# write it, so it must be a path all of them can reach.
BBQ_STATE_FILE=

# Set to "false" to strip every unapproved-sample-data flag from the interface
# once the franchisor's real figures are in.
DEMO_DATA=true
