{
  "name": "@bbq/web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "npm run assets:derive && next dev -p 3000",
    "build": "npm run assets:derive && next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "brand:check": "node scripts/check-brand-rules.mjs",
    "verify": "npm run brand:check && npm run typecheck && npm run lint && npm run test && npm run build",
    "assets:derive": "node ../../infra/scripts/generate-image-derivatives.mjs && node ../../infra/scripts/generate-brand-assets.mjs",
    "demo:build": "node ../../infra/scripts/build-static-demo.mjs"
  },
  "dependencies": {
    "next": "^16.3.3",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.18.8",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.3.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
