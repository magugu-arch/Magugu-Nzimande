# Public URL of the deployed site. Used for canonical URLs, Open Graph and the sitemap.
NEXT_PUBLIC_SITE_URL=https://example.com

# Partnership enquiry delivery. Leave unset to run in preview mode: the form
# works end to end but nothing is sent, and the success screen says so.
# Point at Zapier / Make / a CRM intake / your own endpoint. Server-only.
ENQUIRY_WEBHOOK_URL=
# Optional. When set, each delivery carries X-Signature: hex HMAC-SHA256 of the
# `enquiry` JSON part, so the receiver can verify it came from this site.
ENQUIRY_WEBHOOK_SECRET=
